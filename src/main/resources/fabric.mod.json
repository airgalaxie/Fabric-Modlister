  "name": "Fabric-Modlister",
  "description": "Publishes the loaded Fabric mods through Minecraft's GS4 full query.",
  "authors": [],
  "contact": {},
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "main": [
      "de.airgalaxie.fabricModlister.FabricModlister"
    ]
  },
  "mixins": [
    "fabric-modlister.mixins.json"
  ],
  "depends": {
